{
  "buildCommand": "npm run build -w packages/core && cd apps/consumer && npx next build",
  "outputDirectory": "apps/consumer/.next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    { "path": "/api/cron/sync-tracking", "schedule": "0 8 * * *" },
    { "path": "/api/cron/voice-reconcile", "schedule": "*/10 * * * *" },
    { "path": "/api/cron/deletion-retry", "schedule": "*/30 * * * *" }
  ]
}
