# Database (Neon PostgreSQL — shared with Crucible)
DATABASE_URL=

# Auth.js
AUTH_SECRET=
AUTH_RESEND_KEY=

# AI (Anthropic -- primary for analyze, forge, resume generation)
ANTHROPIC_API_KEY=

# AI (OpenAI -- gpt-4o-mini for resume parsing; redundancy target)
OPENAI_API_KEY=

# Job Search (JSearch via RapidAPI)
JSEARCH_API_KEY=

# R2 Storage (Cloudflare — for resume files, artifacts)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=crucible-files

# Dev: set to "true" to skip all AI API calls and return fixture data (zero cost)
# MOCK_AI=true

# Emails pre-authorized for partner tier on sign-in, with the org code each is
# bound to for funder attribution. Format: "email:CODE,email2:CODE2"
# (a bare email still elevates, it just records no attribution).
# UNSET MEANS NOBODY IS PRE-AUTHORIZED, which is the correct default --
# pre-authorization is an exception granted per engagement, not a standing
# state of the software. Never commit a real address here.
PARTNER_PRE_AUTH=
